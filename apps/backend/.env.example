# Desarrollo. Seleccionar NODE_ENV en el entorno del proceso antes de arrancar.
NODE_ENV=development
PORT=3000

# Conexión PostgreSQL: completar localmente. Producción exige TLS.
DATABASE_URL=
DATABASE_SSL=false
# CA PEM opcional; solo con TLS. Nunca desactivar verificación de certificados.
DATABASE_CA_CERT=

# MongoDB local; en producción utilizar conexión TLS validada.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=chorotega_emarket

# Obligatorio. Producción requiere secreto exclusivo, aleatorio y de al menos 32 caracteres.
JWT_SECRET=

# Orígenes exactos separados por comas. Producción exige HTTPS y al menos uno.
# No se incluye un dominio de producción ficticio.
CORS_ORIGIN=

# Presupuestos por operación y por instancia, compartidos entre todos los clientes.
# No identifican IP real detrás de proxies ni utilizan almacenamiento distribuido.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_LOGIN_MAX_REQUESTS=60
ADMIN_LOGIN_MAX_REQUESTS=20
AUTH_REGISTER_MAX_REQUESTS=10
